            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.codex/muxify-status.sh\"",
            "timeout": 5
          }
        ]
      }
