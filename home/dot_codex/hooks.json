        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.codex/muxify-status.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.codex/muxify-status.sh\"",
            "timeout": 5
