{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "solarized",
    "mode": "light"
  },
  "diffs": {
    "wrap": "word",
    "view": "unified"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "terminal": false
  },
  "animations": true,
  "tabs": {
    "enabled": false
  },
  "plugins": [
    {
      "package": {{ joinPath .chezmoi.workingTree "opencode/plugins/session-footer" | quote }}
    }
  ],
  "mini": {
    "footer": "show",
    "mono": false,
    "thinking": "show",
    "tools": "show",
    "shell_output": "show",
    "turn_summary": "show"
  }
}
